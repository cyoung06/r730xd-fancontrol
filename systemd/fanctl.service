[Unit]
Description=R730xd fan controller (model-based fan duty + iDRAC power cap)
After=fanctl-failsafe.service network-online.target
Wants=network-online.target

[Service]
Type=notify
EnvironmentFile=/etc/fanctl.env
ExecStart=/usr/local/bin/fanctl
# runs after every stop, crash or watchdog kill: fans back to the iDRAC
ExecStopPost=/usr/local/bin/fanctl auto
# the control loop pings every INTERVAL; silent for 30 s -> killed and restarted
WatchdogSec=30
Restart=always
RestartSec=5
TimeoutStopSec=20
# sandbox: root is needed only for /dev/ipmi0, the RAPL counters and the PERC ioctl (CAP_SYS_ADMIN)
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN
DevicePolicy=closed
DeviceAllow=/dev/ipmi0 rw
DeviceAllow=/dev/megaraid_sas_ioctl_node rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
