[Unit]
Description=R730xd fan controller (model-based fan duty + iDRAC power cap)
# no other dependencies: it must run whatever else is up (the HTTP listener retries by itself)
After=fanctl-failsafe.service

[Service]
Type=notify
# '-': a missing file must not also block ExecStopPost (the hand-back)
EnvironmentFile=-/etc/fanctl.env
# create the PERC ioctl node (the driver doesn't), outside the sandbox
ExecStartPre=-+/usr/local/bin/fanctl prepare
ExecStart=/usr/local/bin/fanctl
# runs after every stop, crash or watchdog kill: fans back to the iDRAC
ExecStopPost=/usr/local/bin/fanctl auto
# the control loop pings every INTERVAL (<= 10 s); silent for 60 s -> killed and restarted
WatchdogSec=60
Restart=always
RestartSec=5
TimeoutStopSec=20
# sandbox: root is needed only for /dev/ipmi0, the RAPL counters and the PERC ioctl (CAP_SYS_ADMIN)
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN
DevicePolicy=closed
DeviceAllow=/dev/ipmi0 rw
DeviceAllow=char-megaraid_sas_ioctl rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
