[Unit]
Description=R730xd fan controller (model-based fan duty + iDRAC power cap)
# no other dependencies: it must run whatever else is up (the HTTP listener retries by itself)
After=fanctl-failsafe.service

[Service]
Type=notify
# settings: /etc/fanctl.toml (read by fanctl itself; fanctl auto reads only power.cap_max, leniently)
# create the PERC ioctl node (the driver doesn't), outside the sandbox
ExecStartPre=-+/usr/local/bin/fanctl prepare
ExecStart=/usr/local/bin/fanctl
# re-read /etc/fanctl.toml without a restart (the fans stay under fanctl; a bad file is refused)
ExecReload=/bin/kill -HUP $MAINPID
# runs after every stop, crash or watchdog kill: fans back to the iDRAC
ExecStopPost=/usr/local/bin/fanctl auto
# the control loop pings every INTERVAL (<= 10 s); silent for 60 s -> killed and restarted
WatchdogSec=60
Restart=always
RestartSec=5
TimeoutStopSec=20
# /run/fanctl/throttle: CPU settings saved while clamped; kept across a crash so ExecStopPost and
# the next start can undo the clamp
RuntimeDirectory=fanctl
RuntimeDirectoryPreserve=yes
# sandbox: root is needed only for /dev/ipmi0, the RAPL counters and the PERC ioctl (CAP_SYS_ADMIN)
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN
DevicePolicy=closed
DeviceAllow=/dev/ipmi0 rw
DeviceAllow=char-megaraid_sas_ioctl rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
# ...except the CPU frequency limits: the sensor-gap throttle (RAPL itself is locked by the BIOS)
ReadWritePaths=/sys/devices/system/cpu/intel_pstate
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
