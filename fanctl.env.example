# fanctl settings, installed as /etc/fanctl.env (chmod 600). After editing: sudo systemctl restart fanctl
MODE=model
FIXED_PCT=20
MIN_PCT=10
# model mode: lowest duty that settles the hottest CPU at CPU_TARGET; the feedforward and cap aim
# MODEL_MARGIN below it and the correction trims; at/above CPU_LIMIT jump to EMERGENCY_PCT at once
CPU_TARGET=75
MODEL_MARGIN=3
CPU_LIMIT=78
EMERGENCY_PCT=50
# CPU never pushes the fans past FAN_MAX; the iDRAC power cap is set to the most power that holds
# CPU_TARGET at FAN_MAX instead (0 = off), never below PCAP_MIN
FAN_MAX=20
PCAP_MIN=230
# model mode: fan floor vs hottest CPU (keeps headroom)
WARM_CURVE=68:10,72:15,76:20
# curves "temp:fan%,..." - duty = highest of the three, linear between points
CPU_CURVE=55:10,62:15,68:25,74:40,80:60
HDD_CURVE=38:10,41:20,44:35,47:50
# exhaust stands in for PERC/RAM/PCIe (no sensors)
EXHAUST_CURVE=38:10,42:25,46:45
# at/above any of these the iDRAC takes over
CPU_AUTO=85
HDD_AUTO=50
EXHAUST_AUTO=50
# temperatures that must read every cycle; a missing one hands the fans to the iDRAC
REQUIRED_TEMPS=CPU1,CPU2,Inlet,Exhaust
# drives that must be visible (0 = no requirement); fewer -> iDRAC
HDD_MIN=0
# a fan below this (dead, stalled, missing) -> iDRAC
FAN_MIN_RPM=1000
INTERVAL=5
HDD_INTERVAL=300
# /metrics and /control; comma-separated, e.g. 127.0.0.1:9101,192.168.1.10:9101
LISTEN=127.0.0.1:9101
# enables /control?token=...&mode=...; empty = disabled
CONTROL_TOKEN=
